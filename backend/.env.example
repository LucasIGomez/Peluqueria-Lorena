# ─────────────────────────────────────────────────────────────
# Peluquería Lorena — Variables de Entorno de Producción / Dev
# ─────────────────────────────────────────────────────────────

# Django Core
DJANGO_SECRET_KEY=clave_secreta_super_segura_para_django
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,100.82.23.52

# Base de datos (si se usa PostgreSQL en producción)
# DB_NAME=pelulorena_db
# DB_USER=pelulorena_user
# DB_PASSWORD=tu_password_seguro
# DB_HOST=localhost
# DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# Google Gemini SDK (Inteligencia Artificial del Bot Asistente)
# ─────────────────────────────────────────────────────────────
# Se obtiene en Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash

# ─────────────────────────────────────────────────────────────
# Meta Cloud API (WhatsApp Business)
# ─────────────────────────────────────────────────────────────
# 1. WHATSAPP_VERIFY_TOKEN:
#    Cadena aleatoria y secreta definida por vos. Se configura en
#    Meta for Developers > WhatsApp > Configuración > Webhook > "Token de verificación".
WHATSAPP_VERIFY_TOKEN=token_secreto_para_handshake_con_meta

# 2. WHATSAPP_APP_SECRET:
#    Clave secreta de tu aplicación en Meta Developers (Configuración básica > Clave secreta de la app).
#    Se usa para verificar la firma criptográfica HMAC-SHA256 del header X-Hub-Signature-256.
WHATSAPP_APP_SECRET=tu_app_secret_de_meta

# 3. WHATSAPP_PHONE_NUMBER_ID:
#    Identificador numérico del número de WhatsApp en Meta (WhatsApp > Configuración de la API > "Identificador de número de teléfono").
WHATSAPP_PHONE_NUMBER_ID=100200300400500

# 4. WHATSAPP_ACCESS_TOKEN:
#    Token permanente de usuario del sistema con permisos 'whatsapp_business_messaging' y 'whatsapp_business_management'.
WHATSAPP_ACCESS_TOKEN=EAA...
